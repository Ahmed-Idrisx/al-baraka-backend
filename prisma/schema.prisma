
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ENUMS

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum PaymentStatus {
  UNPAID
  PAID

  @@map("payment_status")
}

enum PaymentMethod {
  CASH_ON_DELIVERY

  @@map("payment_method")
}


// CATEGORY

model Category {
  id    String @id @default(uuid()) @db.Uuid
  name  String
  slug  String @unique
  image String?
  order Int    @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("categories")
}

// PRODUCT

model Product {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  slug          String  @unique
  description   String?
  categoryId    String  @db.Uuid
  price         Decimal @db.Decimal(12, 2)
  discountPrice Decimal? @db.Decimal(12, 2)
  unit          String
  stock         Int     @default(0)
  image         String
  isAvailable   Boolean @default(true)

  category      Category @relation(fields: [categoryId],references: [id],onDelete: Restrict,onUpdate: Cascade)

  orderItems    OrderItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryId])
  @@index([isAvailable])
  @@index([name])
  @@map("products")
}


// ============================================================
// DELIVERY AREA
// ============================================================

model DeliveryArea {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  price    Decimal @db.Decimal(12, 2)
  isActive Boolean @default(true)
  order    Int     @default(0)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
  @@map("delivery_areas")
}


// ============================================================
// ORDER
// ============================================================

model Order {
  id          String @id @default(uuid()) @db.Uuid
  orderNumber String @unique


  // Customer snapshot
  customerName    String
  customerPhone   String
  customerAddress String
  customerNotes   String?

  // Delivery area snapshot
  deliveryAreaId    String  @db.Uuid
  deliveryAreaName  String
  deliveryAreaPrice Decimal @db.Decimal(12, 2)

  deliveryArea DeliveryArea @relation( fields: [deliveryAreaId],references: [id],onUpdate: Cascade)

  // Financials
  subtotal    Decimal @db.Decimal(12, 2)
  deliveryFee Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  // Status
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY)
  paymentStatus PaymentStatus @default(UNPAID)

  // Items
  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([deliveryAreaId])
  @@map("orders")
}

// ORDER ITEM

model OrderItem {
  id String @id @default(uuid()) @db.Uuid

  orderId   String @db.Uuid
  productId String @db.Uuid

  // Snapshot at order time
  name     String
  price    Decimal @db.Decimal(12, 2)
  unit     String
  quantity Int

  order    Order @relation(fields: [orderId],references: [id],onDelete: Cascade,onUpdate: Cascade)

  product  Product @relation(fields: [productId],references: [id],onDelete: Restrict,onUpdate: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ============================================================
// SETTINGS
// ============================================================

model Settings {
  id String @id @default(uuid()) @db.Uuid

  storeName    String   @default("البركة")
  storePhone   String   @default("")
  workingHours String   @default("")
  units        String[] @default(["كجم", "قطعة", "نصف كيلو", "ربع كيلو", "صينية"])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}